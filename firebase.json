{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "hosting-redirect",
    "redirects": [
      {
        "source": "**",
        "destination": "https://logrinssam.github.io/mathhero_decimals/",
        "type": 301
      }
    ]
  }
}
